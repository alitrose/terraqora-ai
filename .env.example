# ============================================================
# TerraQora AI — Environment Configuration Template
# Copy to .env for local development. NEVER commit .env to Git.
# ============================================================

# --- Application ---
APP_NAME=TerraQora AI
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Security & Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-secure-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL) ---
# Production Render / Managed PostgreSQL example:
# postgresql+psycopg://user:password@host:5432/terraqora_db?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:replace-with-password@localhost:5432/terraqora_ai

# --- CORS ---
# Comma-separated allowed origins (no wildcard * in production)
CORS_ORIGINS=http://localhost:5173,https://terraqora-ai.vercel.app

# --- Generative AI Providers ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Optional future OpenAI provider abstraction
OPENAI_API_KEY=your-openai-api-key-optional
OPENAI_MODEL=gpt-4o-mini

# --- Weather Intelligence ---
# Primary: Open-Meteo (no key required). Optional enrichment: OpenWeatherMap.
WEATHER_PROVIDER=open_meteo
OPENWEATHER_API_KEY=your-openweather-api-key-optional

# --- Upload & Rate Limiting ---
MAX_UPLOAD_IMAGE_MB=5
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AI=20/minute

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=TerraQora AI
